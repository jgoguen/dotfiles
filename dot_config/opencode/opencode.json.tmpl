{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@mohak34/opencode-notifier@latest",
    "opencode2-direnv",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@tarquinen/opencode-dcp@latest"
  ],
  "formatter": false,
  "lsp": {
    "pyright": {
      "disabled": true
    {{ if findOneExecutable "basedpyright-langserver" (list (joinPath .chezmoi.homeDir ".local/share/nvim/mason/bin")) -}}
    },
    "basedpyright": {
      "command": ["{{ .chezmoi.homeDir }}/.local/share/nvim/mason/bin/basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"],
      "initialization": {
        "basedpyright": {
          "analysis": {
            "autoImportCompletions": true,
            "autoSearchPaths": true,
            "diagnosticMode": "openFilesOnly"
          }
        }
      }
    {{- end }},
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
