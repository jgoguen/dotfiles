#!/usr/bin/env zsh

# Give each Git worktree its own OpenCode session history by storing the
# OpenCode database inside the worktree, inside
# `<worktree-dir>/.opencode/opencode.db`. This prevents sessions from
# different worktrees of the same repository from being mixed together.
# --use-wt=<worktree> can be used to intentionally share another worktree's
# history. Outside a Git worktree, OpenCode behaves normally.
#
# This script requires OpenCode >= 1.17.20. Older/unknown versions
# are passed through to the `opencode` binary unchanged.

required_version="1.17.20"

version_ge() {
	local  major minor patch
	local  required_major required_minor required_patch

	IFS=.  read -r major minor patch <<<"$1"
	IFS=.  read -r required_major required_minor required_patch <<<"$required_version"

	((major > required_major || (\
	major == required_major && minor > required_minor) || (\
	major == required_major && minor == required_minor && patch >= required_patch)))
}

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
	cat  <<'EOF'
Usage: oc [--use-wt=<worktree>] [opencode options...]

  --use-wt=<worktree>  Use the OpenCode DB from another worktree. Initializes the DB there if it doesn't exist
  --help, -h           Show this help.
EOF
	exit  0
fi

version="$(opencode --version 2>/dev/null | head -n1)"

if [[ -z "$version" ]]; then
	echo  "oc: could not determine OpenCode version; falling back to standard behavior" >&2
	exec  opencode "$@"
fi

if ! version_ge "$version"; then
	echo  "oc: OpenCode $version does not support arbitrary database locations (requires >= $required_version); falling back to standard behavior" >&2
	exec  opencode "$@"
fi

current_worktree="$(jj workspace root 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null)" || {
	exec  opencode "$@"
}

worktree="$current_worktree"

if [[ "$1" == --use-wt=* ]]; then
	name="${1#--use-wt=}"

	candidate="$(
		{ jj workspace list --template '"worktree " ++ self.root() ++ "\nHEAD " ++ self.target().commit_id() ++ "\ndetached\n\n"' || git worktree list --porcelain; } \
			|      awk -v name="$name" '
                /^worktree / {
                    path = substr($0, 10)
                    next
                }
                /^$/ {
                    n = path
                    sub(/^.*\//, "", n)
                    if (n == name) {
                        print path
                        exit
                    }
                }
            '
	)"

	if  [[ -z "$candidate" ]]; then
		echo     "oc: no worktree named '$name'" >&2
		exit     1
	fi

	worktree="$candidate"
	shift
fi

DB_PATH="${XDG_CACHE_HOME:-${HOME}/.cache}/opencode/sessions/${worktree##*/}.db"

mkdir -p "$(dirname "${DB_PATH}")"

exec env \
	OPENCODE_DB="${DB_PATH}" \
	opencode  "$@"
